{
  "name": "osusume",
  "version": "0.7.6",
  "description": "Osusume — self-hosted anime recommendations from your AniList list — deterministic taste profile, local LLM explanations, hidden gems, franchise-aware.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18"
  },
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node src/server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "record-fixtures": "node scripts/record-fixtures.mjs",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --external:electron --outfile=dist-electron/main.mjs && esbuild src/server/index.ts --bundle --platform=node --format=esm --external:vite --outfile=dist-electron/server.mjs",
    "app": "pnpm build && pnpm build:electron && electron .",
    "dist:mac": "pnpm build && pnpm build:electron && electron-builder --mac",
    "dist:win": "pnpm build && pnpm build:electron && electron-builder --win",
    "dist:linux": "pnpm build && pnpm build:electron && electron-builder --linux"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
